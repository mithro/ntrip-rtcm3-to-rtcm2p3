# /etc/ntrip-rtcm3-to-rtcm2p3/env  -- configuration for the systemd service.
# Read by systemd (as root) and passed to the process environment; the password
# therefore never appears on the command line or in `ps`.

# Upstream NTRIP caster password (kept out of NTRIP_ARGS on purpose).
NTRIP_UPSTREAM_PASSWORD=change-me

# All other command-line options. Bind only the LAN interfaces you want served.
NTRIP_ARGS=--upstream-host ntrip.data.gnss.ga.gov.au --upstream-port 2101 --upstream-user mithro --obs-mount ADDE00AUS0 --eph-mount BCEP00BKG0 --listen 127.0.0.1 --listen-port 2101 --station-id 1023
