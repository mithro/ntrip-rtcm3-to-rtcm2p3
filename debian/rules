#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

# Tests run in the CI workflow (ci.yml); skip during packaging because the
# runtime deps (pyrtcm/pynmeagps) are not in the build container's archive.
override_dh_auto_test:

override_dh_installsystemd:
	dh_installsystemd -p ntrip-rtcm3-to-rtcm2p3 --no-start
