#!/usr/bin/make -f

# dh-python hands the changelog's version to setuptools-scm/hatch-vcs as
# SETUPTOOLS_SCM_PRETEND_VERSION. apt-repo-action's shared build stamps
# versions like 0.1.0.post29~deb13~pr5 (docs/packaging.md, "Versions"),
# and ~deb13/~pr5 aren't PEP 440, so the Python build fails on them. The
# wheel gets the part before the first - or ~, the same X.Y.postN that
# hatch-vcs derives from git.
export SETUPTOOLS_SCM_PRETEND_VERSION = $(shell dpkg-parsechangelog -SVersion | sed 's/[-~].*//')

%:
	dh $@ --with python3 --buildsystem=pybuild

# Tests run in deb.yml's test job; skip during packaging because the
# runtime deps (pyrtcm/pynmeagps) are not in the build container's archive.
override_dh_auto_test:

# Enable + start on install, and RESTART on upgrade (the default). The previous
# --no-start left a running service stopped after every package upgrade — a real
# outage — because nothing restarted it. restart-after-upgrade keeps a running
# instance running (picking up the new code) across upgrades.
override_dh_installsystemd:
	dh_installsystemd -p ntrip-rtcm3-to-rtcm2p3 --restart-after-upgrade
